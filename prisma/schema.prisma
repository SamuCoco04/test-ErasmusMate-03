generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id
  code      String   @unique
  name      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  outgoingMobility MobilityRecord[] @relation("HomeInstitution")
  incomingMobility MobilityRecord[] @relation("HostInstitution")
  procedures       ProcedureDefinition[]
}

model User {
  id            String   @id
  email         String   @unique
  displayName   String
  role          String
  institutionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution               Institution        @relation(fields: [institutionId], references: [id])
  mobilityRecords           MobilityRecord[]   @relation("StudentMobilityRecords")
  learningAgreementsAsStudent LearningAgreement[] @relation("LearningAgreementStudent")
  coordinatedMobilityRecords MobilityRecord[]  @relation("CoordinatorMobilityRecords")
  learningAgreementsAsCoordinator LearningAgreement[] @relation("LearningAgreementCoordinator")
  exceptionRequests         ExceptionRequest[] @relation("ExceptionRequester")
  reviewedExceptions        ExceptionRequest[] @relation("ExceptionReviewer")
  auditRecords              AuditRecord[]
  createdLearningAgreementRows LearningAgreementRow[] @relation("LearningAgreementRowCreator")
  reviewedLearningAgreementRows LearningAgreementRow[] @relation("LearningAgreementRowReviewer")
  learningAgreementEvents      LearningAgreementEvent[]
  socialProfile               SocialProfile?

  @@index([role])
  @@index([institutionId])
}

model MobilityRecord {
  id                String   @id
  studentId         String
  coordinatorId     String
  homeInstitutionId String
  hostInstitutionId String
  mobilityStatus    String
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student            User                  @relation("StudentMobilityRecords", fields: [studentId], references: [id])
  coordinator        User                  @relation("CoordinatorMobilityRecords", fields: [coordinatorId], references: [id])
  homeInstitution    Institution           @relation("HomeInstitution", fields: [homeInstitutionId], references: [id])
  hostInstitution    Institution           @relation("HostInstitution", fields: [hostInstitutionId], references: [id])
  submissions        DocumentSubmission[]
  deadlines          Deadline[]
  exceptionRequests  ExceptionRequest[]
  auditRecords       AuditRecord[]
  learningAgreement   LearningAgreement?

  @@index([studentId])
  @@index([coordinatorId])
}

model ProcedureDefinition {
  id            String   @id
  institutionId String
  title         String
  description   String
  isRequired    Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id])
  submissions DocumentSubmission[]
  deadlines Deadline[]

  @@index([institutionId])
}

model DocumentSubmission {
  id             String   @id
  mobilityRecordId String
  procedureId    String
  state          String
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewerNotes  String?
  reopeningRationale String?
  
  events        DocumentSubmissionEvent[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mobilityRecord MobilityRecord      @relation(fields: [mobilityRecordId], references: [id])
  procedure      ProcedureDefinition @relation(fields: [procedureId], references: [id])

  @@index([mobilityRecordId, state])
}

model DocumentSubmissionEvent {
  id            String   @id
  submissionId  String
  actorId       String
  actionType    String
  priorState    String
  newState      String
  rationale     String?
  createdAt     DateTime @default(now())

  submission    DocumentSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId, createdAt])
}

model Deadline {
  id                String   @id
  mobilityRecordId  String
  title             String
  dueDate           DateTime
  state             String
  overrideDueDate   DateTime?
  fulfilledAt       DateTime?
  relatedProcedureId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mobilityRecord    MobilityRecord      @relation(fields: [mobilityRecordId], references: [id])
  relatedProcedure  ProcedureDefinition? @relation(fields: [relatedProcedureId], references: [id])
  exceptionRequests ExceptionRequest[]

  @@index([mobilityRecordId, state])
  @@index([dueDate])
  @@index([relatedProcedureId])
}

model ExceptionRequest {
  id                  String   @id
  mobilityRecordId    String
  requestedById       String
  reviewedById        String?
  title               String
  reason              String
  state               String
  deadlineId          String?
  coordinatorRationale String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mobilityRecord MobilityRecord @relation(fields: [mobilityRecordId], references: [id])
  requestedBy    User           @relation("ExceptionRequester", fields: [requestedById], references: [id])
  reviewedBy     User?          @relation("ExceptionReviewer", fields: [reviewedById], references: [id])
  deadline       Deadline?      @relation(fields: [deadlineId], references: [id])

  @@index([mobilityRecordId, state])
  @@index([requestedById])
  @@index([deadlineId])
}

model AuditRecord {
  id               String   @id
  mobilityRecordId String
  actorId          String
  eventType        String
  details          String
  createdAt        DateTime @default(now())

  mobilityRecord MobilityRecord @relation(fields: [mobilityRecordId], references: [id])
  actor          User           @relation(fields: [actorId], references: [id])

  @@index([mobilityRecordId, createdAt])
}



model SocialProfile {

  id                  String   @id
  userId              String   @unique
  displayName         String
  homeCity            String?
  hostCity            String?
  hostCountry         String?
  homeInstitutionName String?
  hostInstitutionName String?
  studyArea           String?
  mobilityPhase       String?
  languagesJson       String
  interestsJson       String
  bio                 String?
  visibility          String
  contactPreference   String
  moderationState     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  sentConnections     SocialConnection[] @relation("SocialConnectionRequester")
  receivedConnections SocialConnection[] @relation("SocialConnectionReceiver")

  @@index([visibility, moderationState])
  @@index([hostCity, studyArea])
}



model SocialConnection {
  id                    String   @id
  pairKey               String   @unique
  requesterProfileId    String
  receiverProfileId     String
  state                 String
  requestedAt           DateTime
  respondedAt           DateTime?
  blockedAt             DateTime?
  lastActionByProfileId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  requesterProfile      SocialProfile @relation("SocialConnectionRequester", fields: [requesterProfileId], references: [id])
  receiverProfile       SocialProfile @relation("SocialConnectionReceiver", fields: [receiverProfileId], references: [id])

  @@index([requesterProfileId, state])
  @@index([receiverProfileId, state])
}
model LearningAgreement {
  id             String   @id
  mobilityRecordId String @unique
  studentId      String
  coordinatorId  String
  state          String
  version        Int      @default(1)
  submittedAt    DateTime?
  lastReviewedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mobilityRecord MobilityRecord @relation(fields: [mobilityRecordId], references: [id])
  student        User           @relation("LearningAgreementStudent", fields: [studentId], references: [id])
  coordinator    User           @relation("LearningAgreementCoordinator", fields: [coordinatorId], references: [id])
  rows           LearningAgreementRow[]
  events         LearningAgreementEvent[]

  @@index([studentId])
  @@index([coordinatorId])
  @@index([state])
}

model LearningAgreementRow {
  id                    String   @id
  agreementId           String
  rowKey                String
  revision              Int
  isLatest              Boolean
  supersedesRowId       String?
  homeCourseCode        String
  homeCourseName        String
  destinationCourseCode String
  destinationCourseName String
  ects                  Int
  semester              String
  grade                 String?
  status                String
  decisionRationale     String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  agreement             LearningAgreement @relation(fields: [agreementId], references: [id])
  reviewedBy            User?             @relation("LearningAgreementRowReviewer", fields: [reviewedById], references: [id])
  createdBy             User              @relation("LearningAgreementRowCreator", fields: [createdById], references: [id])

  @@index([agreementId, isLatest])
  @@index([rowKey, revision])
}

model LearningAgreementEvent {
  id              String   @id
  agreementId     String
  rowId           String?
  actorId         String
  actionType      String
  fromState       String?
  toState         String?
  noteOrRationale String?
  createdAt       DateTime @default(now())

  agreement       LearningAgreement @relation(fields: [agreementId], references: [id])
  actor           User              @relation(fields: [actorId], references: [id])

  @@index([agreementId, createdAt])
}
